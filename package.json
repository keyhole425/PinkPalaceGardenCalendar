{
	"name": "figgy",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"start:lan": "next start -H 0.0.0.0 -p 3000",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx db/migrate.ts",
		"db:seed": "tsx db/seed/run.ts",
		"db:studio": "drizzle-kit studio",
		"db:reset": "rm -f data/garden.db data/garden.db-wal data/garden.db-shm && npm run db:migrate && npm run db:seed",
		"backup": "tsx scripts/backup.ts",
		"docker:up": "docker compose -f ops/compose.yml up -d --build",
		"docker:logs": "docker compose -f ops/compose.yml logs -f figgy",
		"docker:down": "docker compose -f ops/compose.yml down",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.128.0",
		"@date-fns/tz": "^1.5.0",
		"better-sqlite3": "^13.0.3",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"next": "16.3.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^5.0.2"
	}
}
