# The database. Unset, figgy uses a local file at ./data/garden.db; set both
# to use Turso. Never point development at the production database.
# TURSO_DATABASE_URL=libsql://figgy-<you>.turso.io
# TURSO_AUTH_TOKEN=

# Pins "today" for walking the schedule through other months. Leave unset.
# FIGGY_TODAY=2026-08-15

# For plant research, /ask and logging in plain sentences. Absent is fine:
# those features explain themselves and everything else works.
# ANTHROPIC_API_KEY=
# Only for an organisation-level key, which has to say which workspace to bill.
# ANTHROPIC_WORKSPACE_ID=

# Signing in. Unset locally, Better Auth uses a fixed development secret and
# says so; on Vercel figgy refuses to start without one (openssl rand -base64 32).
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# A local account to sign in as: `npm run admin:dev-user` makes it, on a local
# database file only. These are the same throwaway values the e2e suite uses.
# FIGGY_DEV_EMAIL=gardener@figgy.test
# FIGGY_DEV_PASSWORD=a long e2e password
